# ============================================================
#  JUNCTION Backend — Environment Configuration (.env.example)
#
#  Copy this file to .env and configure values for your environment.
#  DO NOT commit actual secrets or production credentials to git.
# ============================================================

# ── Spring Profile & Server ──────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── PostgreSQL Database Connection ──────────────────────────
# Dev: jdbc:postgresql://localhost:5432/junction_dev
# Prod (Railway): jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
DATABASE_URL=jdbc:postgresql://localhost:5432/junction_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ── Clerk Authentication ────────────────────────────────────
# The JWKS URI publishes public keys used to verify RS256 JWT tokens.
# Example: https://verb-noun-00.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URI=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Expected issuer claim (iss) in Clerk JWTs.
# Example: https://verb-noun-00.clerk.accounts.dev
CLERK_ISSUER_URI=https://your-app.clerk.accounts.dev

# ── Edge Device (CV Bridge) Shared Secret ───────────────────
# Used by Python cv_bridge to authenticate POST /api/observations.
# The bridge sends: Authorization: Bearer <JUNCTION_EDGE_DEVICE_SECRET>
JUNCTION_EDGE_DEVICE_SECRET=replace_with_secure_random_token_minimum_32_characters

# ── CORS Configuration ──────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


{
  "name": "junction-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "JUNCTION — Intelligent Destination Orchestration Platform Monorepo",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && mvn clean package -DskipTests",
    "test:full": "tsx scripts/testing/test-full-system.ts",
    "test:input": "tsx scripts/testing/test-input-system.ts",
    "test:cv": "pytest cv_bridge/tests -v",
    "test:backend": "cd backend && mvn test",
    "generate:qr": "node scripts/utilities/generate_qr.js"
  },
  "dependencies": {
    "@types/node": "^20",
    "dotenv": "^18.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}

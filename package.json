{
  "name": "junction-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "JUNCTION — Intelligent Destination Orchestration Platform Monorepo",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && mvn clean package -DskipTests",
    "test:full": "tsx --tsconfig scripts/tsconfig.json scripts/testing/test-full-system.ts",
    "test:input": "tsx --tsconfig scripts/tsconfig.json scripts/testing/test-input-system.ts",
    "test:cctv": "tsx --tsconfig scripts/tsconfig.json scripts/testing/scenarios/test-cctv-system.ts",
    "test:nugen": "tsx --tsconfig scripts/tsconfig.json scripts/testing/scenarios/test-nugen-task2.ts",
    "test:flow": "tsx --tsconfig scripts/tsconfig.json scripts/testing/scenarios/test-recommendation-attendee-flow.ts",
    "test:resilience": "tsx --tsconfig scripts/tsconfig.json scripts/testing/test-dashboard-resilience.ts",
    "test:cv": "pytest -c cv_bridge/pytest.ini cv_bridge/tests -v",
    "test:backend": "cd backend && mvn test",
    "test:k6:smoke": "k6 run scripts/testing/k6/scenarios/rest-smoke.js",
    "test:k6:load": "k6 run scripts/testing/k6/scenarios/rest-load.js",
    "test:k6:mixed": "k6 run scripts/testing/k6/scenarios/mixed-workload.js",
    "test:k6:stress": "k6 run scripts/testing/k6/scenarios/rest-stress.js",
    "test:k6:spike": "k6 run scripts/testing/k6/scenarios/rest-spike.js",
    "test:k6:soak": "k6 run scripts/testing/k6/scenarios/rest-soak.js",
    "test:k6:websocket": "k6 run scripts/testing/k6/scenarios/websocket-concurrency.js",
    "generate:qr": "node scripts/utilities/generate_qr.js"
  },
  "dependencies": {
    "@types/node": "^20",
    "dotenv": "^18.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}

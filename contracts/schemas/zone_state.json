{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZoneState",
  "type": "object",
  "required": ["id", "name", "pressure", "pressureLevel"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "shortName": { "type": "string" },
    "pressure": { "type": "integer", "minimum": 0, "maximum": 100 },
    "pressureLevel": {
      "type": "string",
      "enum": ["NORMAL", "WATCH", "HIGH", "CRITICAL"]
    },
    "trend": {
      "type": "string",
      "enum": ["INCREASING", "STABLE", "DECREASING"]
    },
    "monitoringStatus": {
      "type": "string",
      "enum": ["CONTINUOUS", "ADAPTIVE", "PERIODIC", "ON_DEMAND"]
    },
    "currentUtilization": { "type": "integer" },
    "usableCapacity": { "type": "integer" },
    "availableCapacity": { "type": "integer" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}


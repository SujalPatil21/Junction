{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedObservation",
  "type": "object",
  "required": ["id", "sourceId", "zoneId", "value"],
  "properties": {
    "id": { "type": "string" },
    "sourceId": { "type": "string" },
    "zoneId": { "type": "string" },
    "resourceId": { "type": "string" },
    "metricType": {
      "type": "string",
      "enum": ["CROWD_COUNT", "DENSITY", "QUEUE_LENGTH", "INFLOW_RATE", "OUTFLOW_RATE"]
    },
    "value": { "type": "number", "minimum": 0 },
    "unit": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "qualityStatus": {
      "type": "string",
      "enum": ["FRESH", "STALE", "DELAYED", "CONFLICTING", "INVALID"]
    },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}

